{
  "$defs": {
    "ReasonCode": {
      "description": "Every reason the system can show. T14 must give each one EN + HI text.",
      "enum": [
        "FLOOR_K1_KNOWN_IN_PATTERN",
        "FLOOR_K2_OUT_OF_PATTERN",
        "FLOOR_N1_NEW_SMALL",
        "FLOOR_N2_NEW_LARGE",
        "FLOOR_C1_BANK_CHANGED",
        "FLOOR_T1_TRUST_ANCHOR",
        "FLOOR_D1_DATA_REQUEST",
        "FLOOR_NONE",
        "EMAIL_AUTH_PASS",
        "EMAIL_DMARC_FAIL",
        "EMAIL_LOOKALIKE_DOMAIN",
        "EMAIL_BANK_NOT_BANK_IN",
        "EMAIL_REPLYTO_MISMATCH",
        "EMAIL_FREEMAIL_CORPORATE",
        "DOC_NO_ISSUES",
        "DOC_ACCOUNT_MISMATCH",
        "DOC_PDF_EDITED",
        "VOICE_NO_SIGNS",
        "VOICE_INCONCLUSIVE",
        "VOICE_LIKELY_SYNTHETIC",
        "VIDEO_NO_SIGNS",
        "VIDEO_INCONCLUSIVE",
        "VIDEO_LIKELY_SYNTHETIC",
        "VIDEO_SUSPICIOUS",
        "IMAGE_FACE_NO_SIGNS",
        "IMAGE_FACE_INCONCLUSIVE",
        "IMAGE_FACE_LIKELY_SYNTHETIC",
        "IMAGE_FACE_SUSPICIOUS",
        "ASK_NEW_ACCOUNT",
        "ASK_CREDENTIAL",
        "ASK_REMOTE_ACCESS",
        "ASK_SECRECY",
        "ASK_BYPASS",
        "ASK_UNUSUAL_PAYMENT_METHOD",
        "ASK_PAYEE_CHANGE",
        "CROSS_CHANNEL_SEQUENCE",
        "CROSS_CHANNEL_URGENT_BYPASS",
        "STYLE_PRESSURE",
        "TEXT_SCAM_LIKELY",
        "WATCHLIST_HIT",
        "VOICE_SEALED",
        "VOICE_UNSEALED_CLAIMED_EXEC",
        "SEAL_PRESENCE_CONFLICT",
        "MULTI_GROUP_STRONG",
        "GREY_FLAG",
        "OOB_DENIED",
        "OOB_APPROVED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "SignalGroup": {
      "enum": [
        "sender_auth",
        "document",
        "media",
        "ask",
        "style",
        "watchlist",
        "provenance",
        "cross_channel"
      ],
      "title": "SignalGroup",
      "type": "string"
    },
    "SignalSource": {
      "enum": [
        "deterministic",
        "ml",
        "llm",
        "human"
      ],
      "title": "SignalSource",
      "type": "string"
    },
    "Strength": {
      "enum": [
        "weak",
        "strong"
      ],
      "title": "Strength",
      "type": "string"
    },
    "TargetRule": {
      "description": "How a signal maps to a target band. Evaluated ONLY in satyapan.policy.targets.",
      "enum": [
        "NONE",
        "VERIFY",
        "HOLD",
        "VERIFY_HOLD_IF_FLOOR_GE_VERIFY",
        "PLUS_ONE",
        "HOLD_IF_MONEY_ELSE_VERIFY"
      ],
      "title": "TargetRule",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A single finding. group/target/strength MUST match SIGNAL_TABLE (validated).\n\nBuild it with Signal.make(code, source=..., evidence_ids=[...]) so you never type\ngroup/target/strength by hand.",
  "properties": {
    "id": {
      "pattern": "^sig_[A-Za-z0-9_\\-]+$",
      "title": "Id",
      "type": "string"
    },
    "code": {
      "$ref": "#/$defs/ReasonCode"
    },
    "group": {
      "$ref": "#/$defs/SignalGroup"
    },
    "target": {
      "$ref": "#/$defs/TargetRule"
    },
    "strength": {
      "$ref": "#/$defs/Strength"
    },
    "source": {
      "$ref": "#/$defs/SignalSource"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "detector": {
      "default": "unknown",
      "title": "Detector",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "detail": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Detail",
      "type": "object"
    }
  },
  "required": [
    "id",
    "code",
    "group",
    "target",
    "strength",
    "source"
  ],
  "title": "Signal",
  "type": "object"
}
