{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/harness/WORKFLOW.md"],
  "default_agent": "implementer",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "src/satyapan/contracts/*": "ask",
      "src/satyapan/policy/*": "ask",
      "tests/conftest.py": "ask",
      "tests/invariants/*": "ask",
      "tests/harness/*": "ask",
      "tests/contracts/*": "ask",
      "AGENTS.md": "ask",
      "opencode.json": "ask",
      ".opencode/*": "ask",
      "*.env": "deny",
      "*.onnx": "deny"
    },
    "bash": {
      "*": "ask",
      "make *": "allow",
      "make clean*": "ask",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run mypy*": "allow",
      "uv run python scripts/*": "allow",
      "node --test*": "allow",
      "npm test*": "allow",
      "npm run *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git switch *": "allow",
      "git checkout -b *": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "rm -r *": "deny",
      "sudo *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "pip install*": "ask",
      "uv add*": "ask",
      "uv pip*": "ask",
      "npm install*": "ask",
      "brew *": "ask"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "doom_loop": "ask"
  }
}
