# Copy to .env (git-ignored). NEVER commit real values. NEVER paste .env into an AI chat.
# Everything works with AWS mode off (local fallbacks).
SATYAPAN_AWS_MODE=off
AWS_REGION=ap-south-1
# AWS credentials: use `aws configure sso` / a named profile, not keys in this file.
AWS_PROFILE=
SATYAPAN_S3_BUCKET=
SATYAPAN_SES_SENDER=
# Local LLM for T15 summaries (Ollama, free). `ollama pull llama3.1:8b` first.
SATYAPAN_LLM_MODEL=llama3.1:8b
SATYAPAN_OLLAMA_URL=http://127.0.0.1:11434
SATYAPAN_CUSTODY_DB=vault_data/custody.db
SATYAPAN_VAULT_DIR=vault_data
SATYAPAN_TRUSTED_AUTHSERV_ID=mx.demo-industries.example
